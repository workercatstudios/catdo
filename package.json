{
  "name": "catdo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "pnpm --filter @catdo/web dev",
    "build": "pnpm --filter @catdo/web build",
    "check": "pnpm --filter @catdo/web routes && tsc --noEmit",
    "test": "vitest run",
    "api:dev": "pnpm dev",
    "deploy": "pnpm build && pnpm --filter @catdo/web run deploy",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.10",
    "@cloudflare/workers-types": "5.20260915.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.36",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.132.0"
  },
  "dependencies": {
    "@clerk/backend": "3.17.2",
    "@clerk/react": "6.15.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.54",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
